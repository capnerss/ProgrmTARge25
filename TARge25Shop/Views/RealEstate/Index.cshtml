@model IEnumerable<TARge25Shop.Models.RealEstate.RealEstateIndexViewModel>

@{
    ViewData["Title"] = "Real Estate";
    short rowNumber = 1;
}

<div class="app-card">
    <div class="app-page-header">
        <div class="header-title-group">
            <h1 class="h2"><i class="bi bi-buildings text-warning"></i> Real Estate</h1>
            <small class="text-muted">Manage property listings, square footage, building types, and room configurations.</small>
        </div>
        <div>
            <a asp-action="create" asp-controller="realEstate" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Create Property
            </a>
        </div>
    </div>

    <form method="get">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th scope="col">Nr</th>
                        <th scope="col">Area</th>
                        <th scope="col">Location</th>
                        <th scope="col">Room Nr</th>
                        <th scope="col">Building Type</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var realEstate in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">@rowNumber</td>
                            <td><span class="fw-semibold">@realEstate.Area</span> <small class="text-muted">m²</small></td>
                            <td><i class="bi bi-geo-alt text-danger me-1"></i>@realEstate.Location</td>
                            <td><span class="badge bg-light text-dark border">@realEstate.RoomNumber rooms</span></td>
                            <td><span class="badge bg-warning text-dark">@realEstate.BuildingType</span></td>
                            <td class="text-end">
                                <a asp-action="details" asp-controller="realEstate" asp-route-id="@realEstate.Id" class="btn btn-sm btn-outline-primary">Details</a>
                                <a asp-action="update" asp-controller="realEstate" asp-route-id="@realEstate.Id" class="btn btn-sm btn-primary">Update</a>
                                <a asp-action="delete" asp-controller="realEstate" asp-route-id="@realEstate.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                        rowNumber += 1;
                    }
                </tbody>
            </table>
        </div>
    </form>
</div>
