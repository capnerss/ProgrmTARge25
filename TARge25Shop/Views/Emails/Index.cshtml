@model TARge25Shop.Models.Emails.EmailsViewModel

@{
    ViewData["Title"] = "Email Dispatcher";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="app-card">
            <div class="app-page-header">
                <div class="header-title-group">
                    <h1 class="h2"><i class="bi bi-envelope-paper text-warning"></i> Send Email</h1>
                    <small class="text-muted">Dispatch secure email messages and attachments via configured SMTP credentials.</small>
                </div>
            </div>

            <form method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label asp-for="To" class="form-label fw-bold">Recipient Email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-person text-muted"></i></span>
                        <input asp-for="To" class="form-control border-start-0" placeholder="recipient@example.com" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Subject" class="form-label fw-bold">Subject</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-chat-left-text text-muted"></i></span>
                        <input asp-for="Subject" class="form-control border-start-0" placeholder="Enter subject line..." />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Body" class="form-label fw-bold">Message Content (HTML Supported)</label>
                    <textarea asp-for="Body" class="form-control" style="height: 250px;" placeholder="Write your message here..."></textarea>
                </div>

                <div class="mb-4">
                    <label asp-for="Attachment" class="form-label fw-bold">Attachments (Optional)</label>
                    <input asp-for="Attachment" class="form-control" multiple="multiple" type="file" />
                    <div class="form-text">Max file size 10MB per attachment.</div>
                </div>

                <div>
                    <button asp-controller="Emails" asp-action="SendMessage" class="btn btn-primary">
                        <i class="bi bi-send-fill"></i> Send Message
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
