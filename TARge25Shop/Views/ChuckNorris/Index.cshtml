@model TARge25Shop.Models.ChuckNorris.ChuckNorrisJokesViewModel

@{
    ViewData["Title"] = "Chuck Norris Jokes";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="app-card text-center py-5">
            <div class="feature-icon-wrapper mx-auto mb-3" style="width: 72px; height: 72px; font-size: 2.2rem;">
                <i class="bi bi-emoji-laughing"></i>
            </div>
            <h1 class="h2 mb-3">Chuck Norris Jokes</h1>
            <p class="text-muted mb-4" style="max-width: 480px; margin: 0 auto;">
                Chuck Norris doesn't read code. He stares it down until it executes itself. Click below to pull a random joke from the live API.
            </p>

            <form method="get">
                <button asp-controller="ChuckNorris" asp-action="GetRandomJoke" class="btn btn-primary px-4 py-2">
                    <i class="bi bi-shuffle"></i> Get Random Joke
                </button>
            </form>
        </div>
    </div>
</div>
