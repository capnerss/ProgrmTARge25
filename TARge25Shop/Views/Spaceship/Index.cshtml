@model IEnumerable<TARge25Shop.Models.Spaceship.SpaceshipIndexViewModel>

@{
    ViewData["Title"] = "Spaceships";
    short rowNumber = 1;
}

<div class="app-card">
    <div class="app-page-header">
        <div class="header-title-group">
            <h1 class="h2"><i class="bi bi-rocket-takeoff text-warning"></i> Spaceships</h1>
            <small class="text-muted">Manage your star fleet registry, specifications, and crew manifests.</small>
        </div>
        <div>
            <a asp-action="create" asp-controller="spaceship" id="CreateInIndex" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Create Spaceship
            </a>
        </div>
    </div>

    <form method="get">
        <div class="table-responsive">
            <table id="IndexTable" class="table table-hover">
                <thead>
                    <tr>
                        <th id="IndexRowNumber" scope="col">Nr</th>
                        <th id="IndexNameColumn" scope="col">Name</th>
                        <th id="IndexTypeColumn" scope="col">Type</th>
                        <th id="IndexBuildDateColumn" scope="col">Built Date</th>
                        <th id="IndexCrewColumn" scope="col">Crew</th>
                        <th id="IndexActionsColumn" scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var spaceship in Model)
                    {
                        <tr>
                            <td id="IndexRowNumberSpaceship" class="fw-bold text-muted">@rowNumber</td>
                            <td id="IndexNameSpaceship" class="fw-semibold">@spaceship.Name</td>
                            <td id="IndexTypeSpaceship"><span class="badge bg-light text-dark border">@spaceship.ShipType</span></td>
                            <td id="IndexCreatedAtSpaceship">@spaceship.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td id="IndexCrewSpaceship"><span class="badge bg-warning text-dark"><i class="bi bi-people-fill me-1"></i>@spaceship.Crew</span></td>
                            <td id="IndexActionsSpaceship" class="text-end">
                                <a id="IndexSpaceshipDetails" asp-action="details" asp-controller="spaceship" asp-route-id="@spaceship.Id" class="btn btn-sm btn-outline-primary">Details</a>
                                <a id="IndexSpaceshipUpdate" asp-action="update" asp-controller="spaceship" asp-route-id="@spaceship.Id" class="btn btn-sm btn-primary">Update</a>
                                <a id="IndexSpaceshipDelete" asp-action="delete" asp-controller="spaceship" asp-route-id="@spaceship.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                        rowNumber += 1;
                    }
                </tbody>
            </table>
        </div>
    </form>
</div>
