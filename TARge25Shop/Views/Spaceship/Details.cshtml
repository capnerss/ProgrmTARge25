@model TARge25Shop.Models.Spaceship.SpaceshipDetailsViewModel

<h1>Details</h1>

<div>
    <h4>Spaceship</h4>
    <hr />
    <dl class="row">
        <div class="form-group row">
            <label asp-for="Id"  class="col-sm-2 col-form-label"></label>
            <span id="id">@Html.DisplayFor(model => model.Id)</span>
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="Name"  class="col-sm-2 col-form-label"></label>
            <span id="name">@Html.DisplayFor(model => model.Name)</span>
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="ShipType"  class="col-sm-2 col-form-label"></label>
            <span id="type">@Html.DisplayFor(model => model.ShipType)</span>
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="Crew"  class="col-sm-2 col-form-label"></label>
            <span id="crew">@Html.DisplayFor(model => model.Crew)</span>
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="EnginePower"  class="col-sm-2 col-form-label"></label>
            <span id="power">@Html.DisplayFor(model => model.EnginePower)</span>
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="CreatedAt"  class="col-sm-2 col-form-label"></label>
            <span id="cat">@Html.DisplayFor(model => model.CreatedAt)</span>
        </div>
    </dl>

    <dl class="row">
        <div class="form-group row">
            <label asp-for="UpdatedAt"  class="col-sm-2 col-form-label"></label>
            <span id="uat"> @Html.DisplayFor(model => model.UpdatedAt)</span>
        </div>
    </dl>

    <a asp-action="Index" asp-controller="spaceship" id="back" class="btn btn-success">Back</a>
</div>