@model TARge25Shop.Models.Spaceship.SpaceshipCreateUpdateViewModel

@if (Model.Id.HasValue)
{
    <h1>
        Update
    </h1>
}
else
{
    <h1>
        Create
    </h1>
}

<form method="post" enctype="multipart/form-data">
    <input asp-for="Id" type="hidden" />
    <input asp-for="CreatedAt" type="hidden" />
    <input asp-for="UpdatedAt" type="hidden" />

    <div class="form-group row">
        <label asp-for="Name" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Name" id="CU_NameEntrySpaceShip" class="form-control" />
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="ShipType" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="ShipType" id="CU_ShipTypeEntrySpaceShip" class="form-control" />
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="Crew" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Crew" id="CU_CrewEntrySpaceShip" class="form-control" />
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="EnginePower" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="EnginePower" id="CU_EnginePowerEntrySpaceShip"  class="form-control" />
        </div>
    </div>

    @if (Model.Id.HasValue)
    {
        <input asp-action="update" asp-controller="spaceship" id="CU_UpdateSpaceShip"  type="submit" class="btn btn-success" value="Update" />
    }
    else
    {
        <input asp-action="create" asp-controller="spaceship" id="CU_CreateSpaceShip"  type="submit" class="btn btn-success" value="Create" />
    }

    <a asp-action="Index" asp-controller="spaceship" id="CU_Back" class="btn btn-secondary">Back to List</a>
</form>