@model TARge25Shop.Models.Spaceship.SpaceshipDeleteViewModel

@{
    ViewData["Title"] = "Delete Spaceship";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="app-card">
            <div class="app-page-header">
                <div class="header-title-group">
                    <h1 class="h2 text-danger"><i class="bi bi-exclamation-triangle-fill"></i> Delete Spaceship</h1>
                    <small class="text-muted">Are you sure you want to permanently delete this spaceship?</small>
                </div>
            </div>

            <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                <i class="bi bi-exclamation-octagon-fill fs-4 me-2"></i>
                <div>
                    This action cannot be undone. All fleet records for <strong>@Model.Name</strong> will be removed.
                </div>
            </div>

            <div class="mb-4">
                <div class="row py-2 border-bottom">
                    <label asp-for="Id" class="col-sm-3 col-form-label fw-bold text-muted"></label>
                    <div class="col-sm-9 d-flex align-items-center">
                        <span class="font-monospace">@Html.DisplayFor(model => model.Id)</span>
                    </div>
                </div>

                <div class="row py-2 border-bottom">
                    <label asp-for="Name" class="col-sm-3 col-form-label fw-bold text-muted"></label>
                    <div class="col-sm-9 d-flex align-items-center">
                        <span class="fs-5 fw-bold text-danger">@Html.DisplayFor(model => model.Name)</span>
                    </div>
                </div>

                <div class="row py-2 border-bottom">
                    <label asp-for="ShipType" class="col-sm-3 col-form-label fw-bold text-muted"></label>
                    <div class="col-sm-9 d-flex align-items-center">
                        <span class="badge bg-light text-dark border p-2">@Html.DisplayFor(model => model.ShipType)</span>
                    </div>
                </div>

                <div class="row py-2 border-bottom">
                    <label asp-for="Crew" class="col-sm-3 col-form-label fw-bold text-muted"></label>
                    <div class="col-sm-9 d-flex align-items-center">
                        <span class="badge bg-warning text-dark p-2">@Html.DisplayFor(model => model.Crew)</span>
                    </div>
                </div>

                <div class="row py-2 border-bottom">
                    <label asp-for="EnginePower" class="col-sm-3 col-form-label fw-bold text-muted"></label>
                    <div class="col-sm-9 d-flex align-items-center">
                        <span>@Html.DisplayFor(model => model.EnginePower) kW</span>
                    </div>
                </div>

                <div class="row py-2">
                    <label asp-for="CreatedAt" class="col-sm-3 col-form-label fw-bold text-muted"></label>
                    <div class="col-sm-9 d-flex align-items-center">
                        <span class="text-muted">@Html.DisplayFor(model => model.CreatedAt)</span>
                    </div>
                </div>
            </div>

            <form asp-action="DeleteConfirmation">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-outline-danger">
                        <i class="bi bi-trash-fill"></i> Confirm Delete
                    </button>
                    <a asp-action="Index" asp-controller="spaceship" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Cancel &amp; Back
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
