@model IEnumerable<TARge25Shop.Models.Kindergarten.KindergartenIndexViewModel>

<div>
    <a asp-action="create" asp-controller="kindergarten" id="CreateInIndex" type="submit" class="btn btn-primary">Create</a>
</div>

@{
    short rowNumber = 1;
}

<div class="h1">
    Kindergartens
</div>
<form method="get">
    <table id="IndexTable" class="table table-hover">
        <thead>
            <tr>
                <th id="IndexRowNumber" scope="col">Nr</th>
                <th id="IndexNameColumn" scope="col">Group Name</th>
                <th id="IndexTypeColumn"  scope="col">Children Count</th>
                <th id="IndexBuildDateColumn" scope="col">Kindergarten</th>
                <th id="IndexCrewColumn"  scope="col">Teacher</th>
                <th id="IndexActionsColumn" scope="col">Created At</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var kindergarten in Model)
            {
                <tr>
                    <td id="IndexRowNumberKindergarten">@rowNumber</td>
                    <td id="IndexNameKindergarten">@kindergarten.GroupName</td>
                    <td id="IndexTypeKindergarten">@kindergarten.ChildrenCount</td>
                    <td id="IndexCreatedAtKindergarten">@kindergarten.KindergartenName</td>
                    <td id="IndexCrewKindergarten">@kindergarten.TeacherName</td>
                    <td>@kindergarten.CreatedAt</td>
                    <td id="IndexActionsKindergarten">
                        <a id="IndexKindergartenDetails" asp-action="details" asp-controller="kindergarten" asp-route-id="@kindergarten.Id" class="btn btn-primary">Details</a>
                        <a id="IndexKindergartenUpdate" asp-action="update" asp-controller="kindergarten" asp-route-id="@kindergarten.Id" class="btn btn-primary">Update</a>
                        <a id="IndexKindergartenDelete" asp-action="delete" asp-controller="kindergarten" asp-route-id="@kindergarten.Id" class="btn btn-outline-danger">Delete</a>
                    </td>
                </tr>
                rowNumber += 1;
            }
        </tbody>
    </table>
</form>
