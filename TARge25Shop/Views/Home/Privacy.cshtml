@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="app-card">
            <div class="app-page-header">
                <div class="header-title-group">
                    <h1 class="h2"><i class="bi bi-shield-check text-warning"></i> Privacy Policy</h1>
                    <small class="text-muted">How TARge25Shop manages and protects user privacy.</small>
                </div>
            </div>

            <p class="lead text-muted mb-4">
                At TARge25Shop, we are committed to safeguarding personal information, fleet metrics, property records, and service credentials.
            </p>

            <div class="mb-3">
                <h5 class="fw-bold" style="color: var(--brand-orange);"><i class="bi bi-key me-2"></i>Secret Management</h5>
                <p class="text-muted">
                    All sensitive API credentials, email accounts, and tokens are maintained via .NET User Secrets and are never committed directly into shared repositories.
                </p>
            </div>

            <div class="mb-4">
                <h5 class="fw-bold" style="color: var(--brand-orange);"><i class="bi bi-database me-2"></i>Data Storage</h5>
                <p class="text-muted">
                    Database records are managed through Entity Framework Core with strict role access and local SQL Server instances.
                </p>
            </div>

            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Return Home
            </a>
        </div>
    </div>
</div>
